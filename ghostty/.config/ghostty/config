# Core Theme
theme = Catppuccin Mocha

# Font (Requires a Nerd Font for Oh My Zsh/Tmux icons)
font-family = "MesloLGS NF"
font-size = 14

background-blur-radius = 20

mouse-hide-while-typing = true
macos-option-as-alt = true

command = /bin/sh -l -c 'if [ "$(uname)" = Darwin ]; then PATH="/opt/homebrew/bin:$PATH"; fi; exec tmux new -A'


