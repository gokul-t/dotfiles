# Core Theme
theme = Catppuccin Macchiato

# Font (Requires a Nerd Font for Oh My Zsh/Tmux icons)
# font-family = "JetBrainsMono Nerd Font"
# font-size = 12 

font-family = "MesloLGS NF"
font-size = 14

command = /bin/sh -c 'if [ "$(uname)" = Darwin ]; then PATH="/opt/homebrew/bin:$PATH"; fi; exec tmux new-session -A -s default'


