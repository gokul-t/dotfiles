# Core Theme
theme = Catppuccin Mocha

# Font (Requires a Nerd Font for Oh My Zsh/Tmux icons)
font-family = "MesloLGS NF"
font-size = 15

background-opacity = 0.80
background-blur-radius = 20
# Apply background-opacity to cells that paint their own (explicit) background color.
# Without this, apps like tmux panes and OpenCode TUI that fill the screen with an
# explicit background color ignore the window-level opacity and stay opaque.
background-opacity-cells = true
gtk-titlebar-hide-when-maximized = true
maximize = true

mouse-hide-while-typing = true
macos-option-as-alt = true
shell-integration = zsh

command = /bin/sh -l -c 'if [ "$(uname)" = Darwin ]; then PATH="/opt/homebrew/bin:$PATH"; fi; exec tmux new -A'


